{
  "name": "app-player-youtube",
  "version": "0.1.0",
  "private": true,
  "description": "Player de YouTube que toca em monitor secundário",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --mac --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win-legacy": "npm run build && electron-builder --win nsis --x64 --ia32 --config electron-builder.legacy.yml"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "author": "Thiago Vallory",
  "license": "PolyForm-Noncommercial-1.0.0"
}
